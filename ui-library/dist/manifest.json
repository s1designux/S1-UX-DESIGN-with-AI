      "individualFile": "assets/icons/clock.svg",
      "accessibleNamePolicy": "decorative; 트리거의 접근 가능한 이름(aria-label 또는 연결된 label)이 이미 이름을 제공한다",
      "geometry": {
        "frame": {
          "width": 24,
