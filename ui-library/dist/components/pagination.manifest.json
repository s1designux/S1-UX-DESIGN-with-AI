    "nativeSemantics": {
      "status": "required",
      "value": "nav landmark with native buttons"
    },
    "accessibleName": {
      "status": "required",
      "value": "pagination nav 와 이동 버튼 4개에 한국어 이름 — 이전 페이지 묶음 · 이전 페이지 · 다음 페이지 · 다음 페이지 묶음; 번호 버튼은 쪽 번호를 포함한다"
    },
    "keyboard": {
      "status": "required",
      "value": "native Tab, Enter, and Space activation"
    },
    "focus": {
      "status": "required",
      "value": "브라우저 기본 포커스 표시를 그대로 쓴다 — 정본에 focus 표현이 없어 웹에서 만들지 않는다(2026-09-02 river 결정). 단, 이동으로 눌린 버튼이 막히거나 번호 버튼이 다시 그려지면 초점을 현재 쪽 번호 버튼으로 옮겨 body 로 떨어지지 않게 한다."
    },
    "ariaStateSync": {
      "status": "required",
      "value": "runtime keeps aria-current=page, arrow disabled states, and current page label in sync"
    },
    "errorRelation": {
      "status": "not-applicable",
      "reason": "Pagination does not own field errors."
    },
    "reducedMotion": {
      "status": "not-applicable",
      "reason": "The canonical component declares no motion."
    }
  },
  "jsRequired": true,
  "javascript": {
    "runtime": "components/pagination/pagination.js",
    "reason": "현재 쪽·번호 창(한 묶음 최대 6개)·이동 버튼 4개의 막힘 상태를 동기화한다. |<(first)=이전 묶음 첫 쪽, <(previous)=한 쪽 뒤, >(next)=한 쪽 앞, >|(last)=다음 묶음 첫 쪽(river 2026-10-13). 눌러서 막힌 버튼 자리의 초점은 현재 쪽 버튼으로 옮긴다.",
    "methods": [
      "setPage(page)",
      "setTotalPages(count)",
      "page",
      "totalPages"
    ],
    "attributes": {
      "data-total-pages": "총 쪽수(처음 값). 나중에 바꿀 때는 setTotalPages(count) 를 부른다 — 번호 창을 다시 그리고 현재 쪽 표시를 유지한다",
      "data-page": "현재 쪽"
    }
  },
