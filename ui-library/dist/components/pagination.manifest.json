    {
      "id": "edge_set",
      "usage": "first and last"
    }
  ],
  "a11y": {
    "nativeSemantics": {
      "status": "required",
      "value": "nav landmark with native buttons"
    },
    "accessibleName": {
      "status": "required",
      "value": "pagination nav and four arrows have Korean labels; pages include their number"
    },
    "keyboard": {
      "status": "required",
      "value": "native Tab, Enter, and Space activation"
    },
    "focus": {
      "status": "required",
      "value": "2px visible outline on focused enabled button"
    },
    "ariaStateSync": {
      "status": "required",
