  },
  "cssContract": {
    "entry": "components/pagination.css",
    "rootScope": "[data-s1-component=pagination]",
    "nativeStates": [
      ":hover",
      ":disabled",
      ":focus-visible"
    ],
    "ariaStates": [
      "[aria-current=page]"
    ],
