{
  "name": "@s1/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "S1 canonical web UI library",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./dist/s1-ui.js",
    "./css": "./dist/s1-ui.css",
    "./tokens.css": "./dist/assets/css/tokens.css",
    "./typography.css": "./dist/assets/css/typography.css",
    "./auto-init": "./dist/s1-ui.auto.js",
    "./components/input": "./dist/components/input.js",
    "./components/input/css": "./dist/components/input.css",
    "./components/input/html": "./dist/examples/input.html",
    "./components/button": "./dist/components/button.js",
    "./components/button/css": "./dist/components/button.css",
    "./components/button/html": "./dist/examples/button.html",
    "./components/checkbox": "./dist/components/checkbox.js",
    "./components/checkbox/css": "./dist/components/checkbox.css",
    "./components/checkbox/html": "./dist/examples/checkbox.html",
    "./components/radio": "./dist/components/radio.js",
    "./components/radio/css": "./dist/components/radio.css",
    "./components/radio/html": "./dist/examples/radio.html",
    "./components/toggle": "./dist/components/toggle.js",
    "./components/toggle/css": "./dist/components/toggle.css",
    "./components/toggle/html": "./dist/examples/toggle.html",
    "./components/chip": "./dist/components/chip.js",
    "./components/chip/css": "./dist/components/chip.css",
    "./components/chip/html": "./dist/examples/chip.html",
    "./components/dropdown": "./dist/components/dropdown.js",
    "./components/dropdown/css": "./dist/components/dropdown.css",
    "./components/dropdown/html": "./dist/examples/dropdown.html",
    "./components/select": "./dist/components/select.js",
    "./components/select/css": "./dist/components/select.css",
    "./components/select/html": "./dist/examples/select.html",
    "./components/filter-chip": "./dist/components/filter-chip.js",
    "./components/filter-chip/css": "./dist/components/filter-chip.css",
    "./components/filter-chip/html": "./dist/examples/filter-chip.html",
    "./manifest": "./dist/manifest.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node scripts/test.mjs",
    "test:check": "node scripts/test.mjs --check"
  }
}
