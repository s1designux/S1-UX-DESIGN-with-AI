  "canonicalSources": [
    "plugins/figma-vars-installer/src/build-components.ts",
    "plugins/figma-vars-installer/src/vars-data.ts",
    "plugins/figma-vars-installer/src/textstyles-data.ts",
    "registry/components/toggle.json"
  ],
  "rootSelector": "[data-s1-component=\"toggle\"]",
  "variants": [
    "base"
  ],
  "sizes": [],
  "geometry": {
    "track": {
      "width": "--sizing-40",
      "height": "--sizing-20",
      "radius": "--radius-full"
    },
    "knob": {
      "width": "--sizing-16",
      "height": "--sizing-16",
      "offset": "--spacing-2",
      "placement": "Off = 왼쪽에서 2px, On = 오른쪽에서 2px. 정본 knob.x 2 / 22 와 같다."
    },
    "source": "build-components.ts buildToggle"
  },
  "states": {
    "off": "aria-checked=false",
    "on": "[aria-checked=\"true\"]",
    "disabled": "disabled",
    "disabledOn": "disabled[aria-checked=\"true\"]"
  },
  "canonicalStateMap": {
    "Pressed=Off, State=Default": "off",
    "Pressed=On, State=Default": "on",
    "Pressed=Off, State=Disabled": "disabled",
    "Pressed=On, State=Disabled": "disabledOn"
  },
  "notInCanon": {
    "hover": "정본 buildToggle 에 Hover 변형이 없다. 웹에서도 만들지 않았다.",
    "motion": "정본에 노브 이동 모션 선언이 없다. transition 을 임의로 넣지 않았다.",
    "focusVisible": "정본에 focus 변형이 없다. 2026-09-02 river 결정으로 웹에서도 만들지 않으며, 키보드 초점은 브라우저 기본 표시에 맡긴다.",
    "label": "정본 트랙에 라벨 부품이 없다. 접근 이름은 aria-label 또는 aria-labelledby 로 붙인다."
  },
  "parts": [
    "knob"
  ],
  "htmlContract": {
    "root": "button[data-s1-component=toggle][role=switch]",
    "requiredAttributes": [
      "type",
      "role",
      "aria-checked"
    ],
    "requiredParts": [
      "knob"
    ],
    "optionalParts": [],
    "relations": [
      "루트 button 이 곧 정본 트랙이다",
      "접근 이름은 aria-label 또는 aria-labelledby"
    ],
    "source": "components/toggle/toggle.example.html",
    "distribution": "examples/toggle.html"
  },
  "cssContract": {
    "entry": "components/toggle.css",
    "rootScope": "[data-s1-component=toggle]",
    "nativeStates": [
      ":disabled"
    ],
    "ariaStates": [
      "[aria-checked=\"true\"]"
    ],
    "customization": "정본 Semantic token만 교체하며 공개 selector의 구조를 override하지 않는다."
  },
  "contentSlots": {},
  "dependencies": {
    "font": [
      {
        "family": "Pretendard",
        "source": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
      }
    ],
    "css": [
      "assets/css/tokens.css",
      "assets/css/typography.css"
    ],
    "coreComponents": []
  },
  "icons": [],
  "a11y": {
    "nativeSemantics": {
      "status": "required",
      "value": "button[role=switch]"
    },
    "accessibleName": {
      "status": "required",
      "value": "aria-label or aria-labelledby"
    },
    "keyboard": {
      "status": "required",
      "value": "native Space and Enter activation with Tab order"
    },
    "focus": {
      "status": "required",
      "value": "브라우저 기본 포커스 표시를 그대로 쓴다 — 정본에 focus 표현이 없어 웹에서 만들지 않는다(2026-09-02 river 결정)."
    },
    "ariaStateSync": {
      "status": "required",
      "value": "runtime keeps aria-checked in sync with the pressed state and emits s1:toggle:change"
    },
    "errorRelation": {
      "status": "not-applicable",
      "reason": "Toggle does not own field errors."
    },
    "reducedMotion": {
      "status": "not-applicable",
      "reason": "The canonical component defines no motion."
    }
  },
  "jsRequired": true,
  "javascript": {
    "runtime": "components/toggle.js",
    "reason": "role=switch 는 native checked 가 없어 aria-checked 상태 전환을 런타임이 담당한다."
  }
}
