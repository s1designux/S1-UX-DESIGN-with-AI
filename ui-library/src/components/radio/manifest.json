    "labelGap": "--spacing-8",
    "source": "build-components.ts buildRadio"
  },
  "states": {
    "default": "native; unchecked and enabled",
    "hover": "@media (hover: hover) control:hover:not(:disabled):not(:checked)",
    "selected": "control:checked",
    "disabled": "control:disabled",
    "disabledSelected": "control:disabled:checked",
    "focusVisible": "control:focus-visible"
  },
  "canonicalStateMap": {
    "Default": "default",
    "Hover": "hover",
    "Selected": "selected",
    "Disabled": "disabled",
    "Dis+Selected": "disabledSelected"
  },
  "canonicalLabelAxis": {
    "Off": "label part를 넣지 않은 기본형",
    "On": "label part를 넣은 형태"
  },
  "notInCanon": {
    "focusVisible": "정본에 focus 변형이 없다. 키보드 접근성 때문에 웹에서만 선택 테두리 토큰으로 표시하며 새 토큰을 만들지 않았다."
  },
  "parts": [
    "control",
    "label"
  ],
  "htmlContract": {
    "root": "div[data-s1-component=radio]",
    "requiredAttributes": [],
    "requiredParts": [
      "control"
    ],
    "optionalParts": [
      "label"
    ],
    "control": "input[type=radio][data-s1-part=control]",
    "relations": [
      "label[for] ↔ control[id]",
      "라벨이 없으면 control 에 aria-label",
      "같은 그룹은 control[name] 이 같아야 한다"
    ],
    "grouping": "그룹은 fieldset·legend 로 감싸고 control[name] 을 공유한다. 화살표 이동은 브라우저가 제공한다.",
    "source": "components/radio/radio.example.html",
    "distribution": "examples/radio.html"
  },
  "cssContract": {
    "entry": "components/radio.css",
    "rootScope": "[data-s1-component=radio]",
    "nativeStates": [
      ":checked",
      ":disabled",
      ":hover",
      ":focus-visible"
    ],
    "customization": "정본 Semantic token만 교체하며 공개 selector의 구조를 override하지 않는다."
  },
  "contentSlots": {
    "label": "optional; 정본 Label=Off 가 기본이고 On 이면 보기 텍스트가 붙는다"
  },
