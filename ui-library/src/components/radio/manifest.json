      }
    ],
    "css": [
      "assets/css/tokens.css",
      "assets/css/typography.css"
    ],
    "coreComponents": []
  },
  "icons": [],
  "a11y": {
    "nativeSemantics": {
      "status": "required",
      "value": "input[type=radio] grouped by name"
    },
    "accessibleName": {
      "status": "required",
      "value": "associated label or aria-label"
    },
    "keyboard": {
      "status": "required",
      "value": "native arrow-key movement inside the name group and Tab into the group"
    },
    "focus": {
      "status": "required",
      "value": "2px outline in the canonical selected border token, 2px offset"
    },
    "ariaStateSync": {
      "status": "not-applicable",
