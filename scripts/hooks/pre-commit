#!/usr/bin/env bash
# git pre-commit hook — 토큰/구조 Gate 강제. 실패 시 커밋 차단.
#
# 설치: scripts/hooks/install-git-hooks.sh 실행 (또는 이 파일을 .git/hooks/pre-commit 로 복사 + chmod +x)
# 버전 관리되는 정본은 이 파일이며, .git/hooks/pre-commit 은 사본이다.
#
# 차단 기준: npm run gate:check 가 error(exit 1)면 차단. warning만이면 통과.
# 우회(비권장): git commit --no-verify

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0

echo "🚧 커밋 검문소 ▶ 검사기 전부 돌리는 중 (npm run gate:check) ..."
# 성공 시 요약 1줄만 남긴다 — 전체 출력이 매 커밋 대화/터미널을 채우던 것을 접음 (2026-08-12).
# 상세가 필요하면: npm run gate:check (경고 포함) / node scripts/gate-check.js --verbose (전체)
OUT="$(npm run --silent gate:check 2>&1)"
if [ $? -eq 0 ]; then
  printf '%s\n' "$OUT" | tail -n 2 | sed '/^$/d'
  echo "🚧 ✅ 검사기 통과 — 커밋 진행"
  exit 0
else
  printf '%s\n' "$OUT"
  echo ""
  echo "🚧 🔴 커밋 차단 — 검사기 실패. 위 ❌ 항목을 고친 뒤 다시 커밋하세요."
  echo "   드리프트면: npm run tokens:sync-prompt && npm run installer:build"
  echo "   우회(비권장): git commit --no-verify"
  exit 1
fi
