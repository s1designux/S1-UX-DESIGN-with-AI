  "usage": {
    "whenToUse": [
      "여러 항목을 독립적으로 켜고 끌 때(다중 선택).",
      "약관 동의처럼 항목마다 따로 켜고 끌 때."
    ],
    "whenNotToUse": [
      "여러 보기 중 하나만 고를 때는 Radio.",
      "단일 on/off 설정은 Toggle."
