.DS_Store
**/.DS_Store

# Claude harness — 워크플로우 정의(agents/skills/docs)만 공유, 나머지는 로컬 전용
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/docs/

# ds-apply 플러그인의 값 사본 — 원본(assets/css/tokens.css · design/DESIGN.core.md)에서
# `node release-skill.js --sync` 로 언제든 재생성되는 배포용 사본. 커밋하면 원본과
# 드리프트가 나도 게이트가 못 잡으므로 추적하지 않는다. (_README.md 는 추적)
plugins/ds-apply/skills/ds-apply/references/tokens.css
plugins/ds-apply/skills/ds-apply/references/DESIGN.core.md
# VERSION.txt 는 --release 가 쓰기만 하는 생성물 (스크립트가 읽지 않음)
plugins/ds-apply/skills/ds-apply/references/VERSION.txt
# /dist/ 는 --release 산출 zip 보관 위치(저장소 루트 한정 — 앞의 / 로 고정).
# 슬래시 없이 dist/ 로 쓰면 plugins/*/dist 등 모든 depth 에 걸리므로 범위를 좁힌다.
/dist/

# 환경변수 — 절대 커밋하지 않음
.env
.env.local

# Figma Variables 수집 결과 — PAT 정보 포함 가능, 커밋하지 않음
registry/figma/figma-variable-metadata.local.json

# npm
node_modules/

# Figma plugin build output
plugins/*/dist/

# Builder preview — 생성 산출물(컨택트시트), 소스(render.js)만 커밋
reports/component-preview/

# Figma MCP raw metadata dump (스냅샷 재생성용 원천 캐시, 비커밋)
data/.figma-raw-metadata.json
