+    const s = figma.combineAsVariants(comps, figma.currentPage);
+    s.name = name;
+    return s;
+  }
+  const byName = new Map<string, ComponentNode>();
+  for (const c of prev.children) {
+    if (c.type === "COMPONENT") byName.set(c.name, c as ComponentNode);
+  }
+  const keep = new Set<string>();
+  LAST_ADOPTED = new Map();
+  // ⚠️ combineAsVariants 는 "넘긴 comps 가 곧 세트의 자식"이라는 계약을 갖는다. 갱신 경로는 fresh 를
+  //   버리므로 그 계약이 깨진다 — 호출부가 fresh 를 계속 쓰면 **제거된 노드 접근 예외**로 죽는다
+  //   (🤖 verifier 가 잡은 치명 결함). 그래서 comps 배열 자체를 살아있는 노드로 **제자리 치환**하고,
+  //   배열 밖에 따로 참조를 들고 있는 호출부는 adoptedNode() 로 재지정하게 한다.
+  for (let i = 0; i < comps.length; i++) {
