+// ⚠️ 여기에 **넣으면 안 되는 것 2가지** (🤖 verifier 2회차가 잡은, ⭐ 가 "보강"하다 만든 결함)
+//   · description·documentationLinks — 정본은 이 둘을 한 번도 설정하지 않는다. 이식하면 빈 값으로
+//     덮어써 **디자이너가 Figma 에 직접 쓴 설명·문서링크를 갱신마다 지운다.**
+//   · explicitVariableModes — **읽기전용**이라 대입해도 아무 일이 없다(try/catch 가 삼켜 된 것처럼
+//     보였다). 모드 핀은 아래 adoptInto 2-c 가 API 로 따로 옮긴다.
+
+/** 새로 그린 variant → 갈아끼워진 기존 variant. 호출부가 죽은 참조를 재지정하는 데 쓴다. */
+let LAST_ADOPTED: Map<ComponentNode, ComponentNode> = new Map();
+/** 갱신으로 버려진 노드 참조를 살아있는 노드로 바꾼다(갱신이 아니었으면 그대로). */
+function adoptedNode(c: ComponentNode): ComponentNode { return LAST_ADOPTED.get(c) || c; }
+
+/** 새로 그린 variant(fresh)의 내용을 기존 variant(old) 안으로 이식하고 fresh 는 버린다. */
+function adoptInto(old: ComponentNode, fresh: ComponentNode): void {
+  // 1) 기존 자식 제거 — 남기면 새 내용과 겹친다.
+  for (const c of [...old.children]) { try { c.remove(); } catch (e) { /* ignore */ } }
+  // 2) 껍데기 속성 이식. layoutMode 를 자식보다 **먼저** 넣어야 오토레이아웃 배치가 맞는다.
+  for (const k of ADOPT_PROPS) {
+    try {
+      const v = (fresh as any)[k];
+      if (v !== undefined && v !== null) (old as any)[k] = v;
+    } catch (e) { /* 읽기전용/미지원 속성은 건너뛴다 */ }
+  }
+  // 크기는 **고정 크기(FIXED)일 때만** 옮긴다. Input variant 처럼 내용에 맞춰 늘어나는(HUG=AUTO)
+  //   프레임에 resize 를 부르면 고정 크기로 못박힐 수 있는데, 정본 경로는 이 노드에 resize 를 한 번도
+  //   부르지 않아 갱신에서만 생기는 차이가 된다. 게다가 자식을 다 뺀 빈 상태에서 부르는 호출이라
+  //   값도 의미가 없다. Figma 문서에 전환 여부가 적혀 있지 않아(🤖 verifier 5회차 ❓) **부르지 않는
+  //   쪽**을 택한다 — AUTO 면 자식을 붙이는 순간 알아서 제 크기를 찾는다.
+  try {
+    const auto = (old as any).primaryAxisSizingMode === "AUTO" || (old as any).counterAxisSizingMode === "AUTO";
+    if (!auto) old.resize(fresh.width, fresh.height);
+  } catch (e) { /* skip */ }
+  // 2-b) 껍데기에 걸린 **숫자 Variable 바인딩**(padding·radius·strokeWeight·itemSpacing 등)을
+  //   원시값이 아니라 바인딩으로 옮긴다. 위 값 복사만 하면 바인딩이 리터럴로 죽어 하드룰 H2 위반.
+  //   fills/strokes 는 paint 객체가 자기 boundVariables 를 갖고 통째로 복사되므로 여기서 제외.
+  try {
+    const bv = (fresh as any).boundVariables || {};
+    for (const field of Object.keys(bv)) {
+      const alias = bv[field];
+      if (!alias || Array.isArray(alias) || !alias.id) continue;
+      const v = figma.variables.getVariableById(alias.id);
+      if (v) (old as any).setBoundVariable(field, v);
+    }
+  } catch (e) { /* 이식 실패 시 값 복사분만 남는다 */ }
+  // 2-c) Appearance 모드 핀(Light/Dark) — 읽기전용이라 대입이 아니라 API 로 옮긴다(setMode 와 동형).
+  try {
+    const modes = (fresh as any).explicitVariableModes || {};
+    for (const cid of Object.keys(modes)) {
+      (old as unknown as { setExplicitVariableModeForCollection: (c: string, m: string) => void })
+        .setExplicitVariableModeForCollection(cid, modes[cid]);
+    }
+  } catch (e) { /* skip */ }
+  // 3) 자식을 **이동**(복제 아님) — componentPropertyReferences 등 자식에 걸린 배선이 그대로 온다.
+  for (const c of [...fresh.children]) { try { old.appendChild(c); } catch (e) { /* ignore */ } }
+  // 4) 세트 안에서의 자리(variant 격자 좌표)는 **건드리지 않는다** — 기존 자리를 그대로 둔다.
+  //   ⚠️ 여기서 fresh 의 좌표를 옮기면 안 된다. 빌더는 variant 에 좌표를 주지 않고(createComponent
+  //   기본값 0,0) **스펙 시트를 그리는 단계가 격자에 배치**한다. 갱신은 그 단계를 건너뛰므로
+  //   fresh 좌표를 따라가면 56개가 전부 (0,0) 에 겹쳐 세트가 무너진다(🤖 verifier 4회차 치명 지적).
+  try { fresh.remove(); } catch (e) { /* ignore */ }
+}
