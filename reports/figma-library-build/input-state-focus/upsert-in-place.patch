+/**
+ * 설치기가 자기가 만든 세트에 남기는 표식(pluginData). 값 = 컴포넌트 이름.
+ *
+ * 왜 이름으로 찾으면 안 되는가 (2026-09-08 실물 1회 실행에서 드러남):
+ *   이 파일에는 옛 설치가 남긴 **같은 이름의 세트가 여러 개** 쌓여 있었다(고아 마스터 세대).
+ *   이름으로 찾아 "첫 번째"를 갱신했더니 시안 30개가 쓰는 세트(2410:13831)가 아니라 아무도 안 쓰는
+ *   잔재 세트(2437:…)를 갱신했다 — 부품표는 바뀌는데 시안은 안 따라오는, 겉보기엔 성공한 실패.
+ *   코드 판독 5회로는 못 잡았다(전부 "세트는 하나"를 전제했다).
+ */
+const CANON_SET_KEY = "s1-canon-set";
+
+/** 세트에 표식을 남긴다(설치·갱신 성공 시). 실패해도 설치를 막지 않는다. */
+function stampCanonSet(set: ComponentSetNode, name: string): void {
+  try { set.setPluginData(CANON_SET_KEY, name); } catch (e) { /* mock/권한 없음 */ }
+}
+
+/**
+ * 갱신할 기존 세트를 찾는다. **표식 우선, 이름은 보조.**
+ *   · 표식이 정확히 1개 → 그것
+ *   · 표식이 0개인데 이름이 정확히 1개 → 표식 이전에 만들어진 세트다. 그것을 쓰고 표식을 남긴다(이관)
+ *   · 어느 쪽이든 **2개 이상이면 고르지 않는다** — 어느 것이 정본인지는 사람이 정할 일이다.
+ * 반환: 세트 · null(없음) · "ambiguous"(여러 개 — 호출부가 중단)
+ */
+function findCanonSet(name: string): ComponentSetNode | null | "ambiguous" {
+  let sets: ComponentSetNode[] = [];
+  try {
+    const r = figma.currentPage.findAll((n) => n.type === "COMPONENT_SET");
+    if (Array.isArray(r)) sets = r as ComponentSetNode[];
+  } catch (e) { return null; } // mock/no-page
+  const stamped = sets.filter((s) => {
+    try { return s.getPluginData(CANON_SET_KEY) === name; } catch (e) { return false; }
+  });
+  if (stamped.length === 1) return stamped[0];
+  if (stamped.length > 1) return "ambiguous";
+  const byName = sets.filter((s) => s.name === name);
+  if (byName.length === 1) { stampCanonSet(byName[0], name); return byName[0]; }
+  if (byName.length > 1) return "ambiguous";
+  return null;
+}
+
+/**
+ * combineAsVariants 의 대체 — REFRESH_TARGETS 에 든 이름이고 기존 세트가 있으면 제자리 갱신,
+ * 아니면 종전대로 새 세트를 만든다. 반환 타입·후속 사용법은 combineAsVariants 와 동일.
+ */
+function upsertSet(comps: ComponentNode[], name: string): ComponentSetNode {
+  LAST_ADOPTED = new Map();
+  const found = REFRESH_TARGETS.has(name) ? findCanonSet(name) : null;
+  if (found === "ambiguous") {
+    // 같은 이름 세트가 여러 개 = 어느 것이 정본인지 기계가 정할 수 없다. 실물에서 이걸 추측했다가
+    //   아무도 안 쓰는 잔재 세트를 갱신했다(2026-09-08). 추측 대신 멈추고 사람에게 넘긴다.
+    for (const c of comps) { try { c.remove(); } catch (e) { /* ignore */ } }
